<Window x:Class="Notchly.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notchly"
        Width="560" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">

    <Window.Resources>
        <!-- Round glyph button (media controls, calendar arrows) -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text pill button (tabs, quick actions) -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="11,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShelfTemplate">
            <Border Width="62" Margin="2" Background="Transparent" Cursor="Hand"
                    PreviewMouseLeftButtonDown="ShelfItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ShelfItem_PreviewMouseMove"
                    MouseLeftButtonDown="ShelfItem_MouseDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="ShelfItem_Open"/>
                        <MenuItem Header="Remove from shelf" Click="ShelfItem_Remove"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="10"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxHeight="28" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppTemplate">
            <Border Width="72" Margin="3" Background="Transparent" Cursor="Hand"
                    MouseLeftButtonUp="App_Click">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove" Click="App_Remove"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,5,0,3"/>
                    <TextBlock Text="{Binding Name}" Foreground="#DDDDDD" FontSize="11"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Notch" Background="Black" Width="270" Height="34"
                CornerRadius="0,0,20,20" ClipToBounds="True"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                AllowDrop="True"
                MouseEnter="Notch_MouseEnter" MouseLeave="Notch_MouseLeave" MouseLeftButtonUp="Notch_Click"
                DragEnter="Notch_DragEnter" DragOver="Notch_DragOver"
                DragLeave="Notch_DragLeave" Drop="Notch_Drop">
            <Grid>
                <!-- Collapsed layer: art/logo | now playing or clock+date | bars + battery -->
                <Grid x:Name="CompactView" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center">
                        <Border.Background>
                            <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="CompactText" Grid.Column="1" Foreground="White" FontSize="11.5" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="Bars" Orientation="Horizontal" Margin="0,0,8,0" Visibility="Collapsed">
                            <Border x:Name="Bar1" Width="3" Height="4" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center"/>
                            <Border x:Name="Bar2" Width="3" Height="4" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center"/>
                            <Border x:Name="Bar3" Width="3" Height="4" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="BatteryCompact" Foreground="#CFCFCF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Welcome animation layer -->
                <Grid x:Name="WelcomeView" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Margin="18,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="46" Height="46" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" ScaleX="0.4" ScaleY="0.4"/>
                            </Image.RenderTransform>
                        </Image>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="WelcomeTitle" Foreground="White" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                            <TextBlock x:Name="WelcomeSub" Foreground="#9A9A9A" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Expanded layer -->
                <Grid x:Name="ExpandedView" Margin="16,10,16,14" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab bar -->
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TabHome" Style="{StaticResource PillBtn}" Content="Home" Tag="Home" Click="Tab_Click"/>
                            <Button x:Name="TabApps" Style="{StaticResource PillBtn}" Content="Apps" Tag="Apps" Click="Tab_Click"/>
                            <Button x:Name="TabCalendar" Style="{StaticResource PillBtn}" Content="Calendar" Tag="Calendar" Click="Tab_Click"/>
                            <Button x:Name="TabSystem" Style="{StaticResource PillBtn}" Content="System" Tag="System" Click="Tab_Click"/>
                        </StackPanel>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE713;" FontSize="13" Foreground="#8A8A8A"
                                Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Settings" Click="Settings_Click"/>
                    </Grid>

                    <!-- ============ HOME: media + shelf ============ -->
                    <Grid x:Name="HomePanel" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="76" Height="76" CornerRadius="12" Background="#1E1E1E" VerticalAlignment="Center">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="76" Height="76" CornerRadius="12" Background="Black"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                                           FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Text="" Foreground="#A0A0A0" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="4" Margin="0,6,0,0"
                                             Background="#333333" Foreground="White" BorderThickness="0"/>
                                <TextBlock x:Name="TimeText" Text="" Foreground="#808080" FontSize="10" Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-6,2,0,0">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="17" Click="Play_Click"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Border Background="#141414" CornerRadius="16"/>
                            <Rectangle RadiusX="16" RadiusY="16" Stroke="#444444" StrokeThickness="1.5"
                                       StrokeDashArray="4 4" IsHitTestVisible="False"/>
                            <TextBlock x:Name="EmptyHint" Text="Drop files here&#x0A;to keep them handy"
                                       Foreground="#777777" FontSize="12" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="6">
                                <ItemsControl ItemsSource="{Binding Shelf}" ItemTemplate="{StaticResource ShelfTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ============ APPS: pinned launcher ============ -->
                    <Grid x:Name="AppsPanel" Grid.Row="1" Visibility="Collapsed">
                        <Border Background="#141414" CornerRadius="16"/>
                        <Rectangle RadiusX="16" RadiusY="16" Stroke="#444444" StrokeThickness="1.5"
                                   StrokeDashArray="4 4" IsHitTestVisible="False"/>
                        <TextBlock x:Name="AppsHint" Text="Drop apps, shortcuts or files here to pin them"
                                   Foreground="#777777" FontSize="12" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="8">
                            <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ CALENDAR: agenda + month ============ -->
                    <Grid x:Name="CalendarPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="AgendaHeader" Foreground="#8B7CFF" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                <StackPanel x:Name="AgendaList"/>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel Grid.Column="1" Width="140">
                            <Grid Height="20">
                                <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" FontSize="10" Width="22" Height="20"
                                        HorizontalAlignment="Left" Click="PrevMonth_Click"/>
                                <TextBlock x:Name="MonthText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" FontSize="10" Width="22" Height="20"
                                        HorizontalAlignment="Right" Click="NextMonth_Click"/>
                            </Grid>
                            <UniformGrid x:Name="CalGrid" Columns="7" Rows="7" Height="105" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ============ SYSTEM ============ -->
                    <Grid x:Name="SystemPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#141414" CornerRadius="16" Padding="16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="CPU" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="CpuBar" Grid.Column="1" Maximum="100" Height="6" VerticalAlignment="Center"
                                             Background="#2A2A2A" Foreground="White" BorderThickness="0"/>
                                <TextBlock x:Name="CpuText" Grid.Column="2" Foreground="White" FontSize="12"
                                           TextAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="RAM" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="RamBar" Grid.Row="1" Grid.Column="1" Maximum="100" Height="6" VerticalAlignment="Center"
                                             Background="#2A2A2A" Foreground="White" BorderThickness="0"/>
                                <TextBlock x:Name="RamText" Grid.Row="1" Grid.Column="2" Foreground="White" FontSize="12"
                                           TextAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Text="Battery" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="BatBar" Grid.Row="2" Grid.Column="1" Maximum="100" Height="6" VerticalAlignment="Center"
                                             Background="#2A2A2A" Foreground="#34C759" BorderThickness="0"/>
                                <TextBlock x:Name="BatText" Grid.Row="2" Grid.Column="2" Foreground="White" FontSize="12"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#141414" CornerRadius="16" Padding="8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Quick actions" Foreground="#8A8A8A" FontSize="11" Margin="6,0,0,4"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PillBtn}" Content="Vol −" Click="VolDown_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Vol +" Click="VolUp_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Mute" Click="Mute_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Snip" Click="Snip_Click"/>
                                    <Button Style="{StaticResource PillBtn}" Content="Lock" Click="Lock_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
